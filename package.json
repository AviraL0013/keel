{
    "name": "keel",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "build": "tsc -p server/tsconfig.json --noEmit",
        "lint": "oxlint",
        "test:risk": "vitest run tests/risk-engine.test.ts tests/risk-stale.test.ts",
        "test": "vitest run",
        "server:dev": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
        "typecheck": "tsc -p server/tsconfig.json --noEmit",
        "server:typecheck": "tsc -p server/tsconfig.json --noEmit",
        "db:migrate": "tsx scripts/migrate.ts",
        "mobile:analyze": "cd apps/mobile && flutter analyze",
        "mobile:test": "cd apps/mobile && flutter test",
        "mobile:build": "cd apps/mobile && flutter build apk --debug"
    },
    "dependencies": {
        "@fastify/cookie": "^11.1.2",
        "@fastify/cors": "^11.3.0",
        "@fastify/rate-limit": "^11.2.0",
        "@noble/ed25519": "^3.2.0",
        "decimal.js": "^10.6.0",
        "fastify": "^5.12.5",
        "pg": "^8.23.0",
        "viem": "^2.56.8",
        "ws": "^8.21.3"
    },
    "devDependencies": {
        "@electric-sql/pglite": "^0.5.8",
        "@types/node": "^24.13.3",
        "@types/pg": "^8.23.1",
        "@types/ws": "^8.18.1",
        "oxlint": "^1.81.0",
        "tsx": "^4.23.13",
        "typescript": "~6.0.2",
        "vitest": "^4.1.11"
    }
}
